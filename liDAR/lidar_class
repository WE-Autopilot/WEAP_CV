import serial
import numpy as np
import time
import driver
from driver import start_reader, packet_queue
from queue import Empty

class lidar_buffer:
    def __init__(self, capacity: int = 5000):
        """
        capacity: number of rays per 360° (e.g. 5000)
        """
        driver.start_reader()

        self.capacity    = capacity
        self.data        = np.zeros(self.capacity, dtype=np.float32)
        # timestamp of last write for each index (seconds since epoch)
        self.timestamps  = np.zeros(self.capacity, dtype=np.float64)
        # resolution: degrees per index
        self._angle_res  = 360.0 / self.capacity

    def _pkt_to_indices(self, start_deg: float, n_pts: int) -> np.ndarray:
        """
        Given a packet that starts at start_deg (0–360) and has n_pts,
        return the array of buffer-indices [i0, i1, …] for those points.
        """
        # linearly spaced angles for each measurement in the packet
        angles = (start_deg + np.arange(n_pts) * 
                  ( (self._angle_res * self.capacity) / self.capacity )) % 360.0
        # convert to indices
        return (angles / self._angle_res).astype(int)

    def listen(self, timeout: float = 1.0):
        """
        Read packets off driver.packet_queue for up to `timeout` seconds,
        update only the covered indices in self.data, and return
        a dict of:
          {
            "aligned_sweep": <np.ndarray of length capacity>,
            "updated_angles": [(θ_start, θ_end), …],
            "updated_values": { idx: distance, … }
          }
        """
        t0 = time.time()
        updated_idxs = set()
        first_start = None

        while True:
            # break on timeout
            if time.time() - t0 > timeout:
                break

            try:
                pkt = packet_queue.get(timeout=timeout - (time.time() - t0))
            except Empty:
                continue

            # extract packet info
            start_deg = pkt["start_angle"] / 100.0  # convert hundredths -> deg
            dists     = [m["distance"] for m in pkt["measurements"]]
            n_pts     = len(dists)

            if first_start is None:
                first_start = start_deg

            # compute the exact indices this packet maps to
            idxs = self._pkt_to_indices(start_deg, n_pts)

            # update only those
            for j, idx in enumerate(idxs):
                new = float(dists[j])
                if new != self.data[idx]:
                    self.data[idx]       = new
                    self.timestamps[idx] = time.time()
                    updated_idxs.add(idx)

        # align so 0° lands at index 0, based on first_start
        if first_start is None:
            aligned = self.data.copy()
        else:
            shift = int(round(first_start / self._angle_res)) % self.capacity
            aligned = np.roll(self.data, -shift)

        # collate which angle ranges changed
        updated_angles = []
        for idx in sorted(updated_idxs):
            θ = idx * self._angle_res
            updated_angles.append( (θ, θ + self._angle_res) )

        # prepare updated_values map
        updated_values = { idx: self.data[idx] for idx in updated_idxs }

        return {
            "aligned_sweep":  aligned,
            "updated_angles": updated_angles,
            "updated_values": updated_values
        }

    def has_updates_between(self, θ_min: float, θ_max: float, since: float):
        """
        Returns True if any ray whose angle ∈ [θ_min,θ_max) was updated
        at a timestamp >= `since` (seconds since epoch).
        """
        # convert to indices
        i_min = int(np.floor( (θ_min % 360) / self._angle_res ))
        i_max = int(np.ceil(  (θ_max % 360) / self._angle_res ))
        # handle wrap-around
        if i_min < i_max:
            ts = self.timestamps[i_min:i_max]
        else:
            ts = np.concatenate((self.timestamps[i_min:], self.timestamps[:i_max]))
        return np.any(ts >= since)
